# Shared results backend (optional).
#
# Without these, #/stats shows only the runs from your own browser.
# With them, every completed quiz adds to global totals.
#
#   1. Create a free project at https://supabase.com
#   2. Run supabase/schema.sql in the SQL editor
#   3. Project Settings -> API -> copy the values below into .env.local
#
# Both values are public by design. The schema only lets this key insert rows
# and call the aggregate function; it cannot read individual submissions.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
